# Supabase (server only; never expose the service-role key to the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=            # at least 32 random characters

# Email fallback (used when the booking engine is unavailable)
GMAIL_USER=
GMAIL_PASS=                      # Gmail app password
HOTEL_BOOKING_EMAIL=booking@theaurasuites.in

NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional UPI payment card on the confirmation screen. Hidden unless the id is set.
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_NAME=Aura Suites
